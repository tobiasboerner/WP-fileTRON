{
	"name": "wp-filetron/wp-filetron",
	"description": "Modern WordPress media manager with folder structure, tagging, and asset tracking",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Your Name",
			"email": "your.email@example.com"
		}
	],
	"keywords": [
		"wordpress",
		"plugin",
		"media",
		"media-library",
		"file-manager",
		"asset-management"
	],
	"require": {
		"php": ">=7.4",
		"symfony/filesystem": "^6.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0",
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpstan/phpstan": "^1.10"
	},
	"autoload": {
		"psr-4": {
			"WP_Filetron\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WP_Filetron\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"phpcs": "phpcs --standard=WordPress includes/ admin/ wp-filetron.php",
		"phpcbf": "phpcbf --standard=WordPress includes/ admin/ wp-filetron.php",
		"phpstan": "phpstan analyse includes/ admin/ --level=5"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
